# CSES Data Harmonization Agent - Environment Configuration
# Copy this file to ~/.cses-agent/.env and fill in your values

# =============================================================================
# API Configuration (REQUIRED)
# =============================================================================

# GESIS OpenWebUI is the recommended default at GESIS.
CSES_USE_GESIS=true
GESIS_API_KEY=...

# Optional direct provider APIs. Toggle these in the Windows GUI.
CSES_USE_OPENAI=false
OPENAI_API_KEY=sk-...
CSES_USE_ANTHROPIC=false
# ANTHROPIC_API_KEY=sk-ant-...
CSES_USE_XAI=false
# XAI_API_KEY=xai-...
CSES_USE_GEMINI=false
# GEMINI_API_KEY=...

# Optional OpenWebUI/OpenAI-compatible API routing.
# Leave this disabled for direct vendor APIs.
# CSES_USE_OPENWEBUI=true
# OPENAI_API_BASE=https://your-openwebui.example.org/api/v1
# OPENWEBUI_API_KEY=sk-or-service-token

# Curated model profile selected by the GUI
# Options: gesis_recommended, openai_balanced, anthropic_balanced, google_balanced, xai_balanced, xai_grok_4_1_fast
CSES_MODEL_PROFILE=gesis_recommended
# Main chat model dropdown choices selected in the GUI
CSES_CHAT_MODELS=openai/gpt-oss:120b
CSES_CHAT_MODEL=openai/gpt-oss:120b

# =============================================================================
# Optional Configuration
# =============================================================================

# Stata executable path (if you have Stata installed)
# STATA_PATH=C:\Program Files\Stata18\StataMP-64.exe

# The Windows GUI can create an MCP-Stata config snippet at:
# ~/.cses-agent/mcp-stata.json

# Enable verbose logging
# DEBUG=true

# =============================================================================
# NOTE: LLM Model Routing
# =============================================================================
# OpenWebUI is optional. The app will not use an OpenAI-compatible base URL
# unless CSES_USE_OPENWEBUI=true and OPENAI_API_BASE is set.
